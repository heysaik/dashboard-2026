#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
has_updates=false
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/main|refs/tags/v*)
      if [ "$local_oid" = "$zero" ]; then
        printf '%s\n' 'Deleting main or a release tag is blocked.' >&2
        exit 1
      fi
      if [ "$remote_oid" != "$zero" ]; then
        case "$remote_ref" in
          refs/tags/v*)
            if [ "$local_oid" != "$remote_oid" ]; then
              printf '%s\n' 'Replacing a release tag is blocked. Publish a new version.' >&2
              exit 1
            fi ;;
          refs/heads/main)
            if ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
              printf '%s\n' 'Non-fast-forward main push blocked. Fetch and reconcile the remote history.' >&2
              exit 1
            fi ;;
        esac
      fi ;;
  esac
  if [ "$local_oid" != "$zero" ]; then has_updates=true; fi
done
if [ "$has_updates" = true ]; then
  if ! command -v gitleaks >/dev/null 2>&1; then
    printf '%s\n' 'Install the required secret scanner: brew install gitleaks' >&2
    exit 1
  fi
  gitleaks git --redact --no-banner --ignore-gitleaks-allow --log-opts=--all .
  node --test Tests/*.test.cjs
fi
