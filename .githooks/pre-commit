#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
git diff --cached --check
expected_email=$(git config --local --get dashboard.expectedEmail || true)
if [ -n "$expected_email" ]; then
  for identity_kind in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    identity=$(git var "$identity_kind")
    case "$identity" in
      *"<$expected_email>"*) ;;
      *) printf '%s\n' 'Commit identity does not match this checkout’s configured personal email.' >&2; exit 1 ;;
    esac
  done
fi
if ! command -v gitleaks >/dev/null 2>&1; then
  printf '%s\n' 'Install the required secret scanner: brew install gitleaks' >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --ignore-gitleaks-allow .
