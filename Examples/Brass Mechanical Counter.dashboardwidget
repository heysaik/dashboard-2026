{"version":1,"width":220,"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;background:transparent;font-family:Helvetica,Arial,sans-serif}.widget{position:relative;width:220px;height:180px;padding:17px 18px 15px;border:1px solid #4d3212;border-radius:22px;background:radial-gradient(circle at 28% 12%,rgba(255,244,177,.42),transparent 27%),repeating-linear-gradient(96deg,rgba(255,255,255,.025) 0 1px,rgba(66,35,8,.025) 1px 3px),linear-gradient(145deg,#c99d45 0%,#8b5c1e 47%,#d0a74d 78%,#76501e 100%);box-shadow:inset 0 2px 1px rgba(255,252,202,.76),inset 0 -4px 8px rgba(52,28,5,.7),inset 4px 0 7px rgba(255,222,123,.24),0 10px 20px rgba(0,0,0,.5),0 2px 3px rgba(0,0,0,.7);color:#211407}.widget:before{content:\"\";position:absolute;inset:7px;border:1px solid rgba(70,39,8,.72);border-radius:16px;box-shadow:0 1px 0 rgba(255,235,154,.52),inset 0 1px 4px rgba(38,20,3,.32);pointer-events:none}.screw{position:absolute;width:9px;height:9px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ecd17d,#75501d 70%);border:1px solid #50330e;box-shadow:0 1px 1px rgba(255,241,178,.45),inset 0 0 2px #382105}.screw:after{content:\"\";position:absolute;left:1px;right:1px;top:3px;height:1px;background:#40280c;transform:rotate(-18deg)}.tl{left:11px;top:11px}.tr{right:11px;top:11px}.bl{left:11px;bottom:11px}.br{right:11px;bottom:11px}.counter{position:relative;height:69px;margin:7px 8px 13px;padding:11px 10px;border-radius:8px;border:2px solid #4a2e0c;background:linear-gradient(#684719,#a77b31 8%,#4c3010 15%,#2b1c0d 84%,#9a6e29 94%,#4c310f);box-shadow:inset 0 3px 5px #281706,0 1px 0 rgba(255,229,139,.64)}.display{height:43px;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px solid #15120d;border-radius:4px;background:linear-gradient(#111 0%,#292929 15%,#080808 49%,#1e1e1e 52%,#090909 100%);box-shadow:inset 0 2px 5px #000,0 1px rgba(255,235,173,.18);color:#f2e5bd;font:700 32px\/1 Menlo,Monaco,monospace;letter-spacing:3px;text-shadow:0 0 4px rgba(255,239,187,.28)}.controls{position:relative;display:grid;grid-template-columns:52px 52px 1fr;gap:8px;margin:0 8px}.btn{height:46px;padding:0;border:1px solid #4b2d0c;border-radius:10px;background:linear-gradient(#e2bd67 0%,#b27e2d 49%,#8b5b1e 52%,#bd8938 100%);box-shadow:inset 0 1px 1px rgba(255,250,205,.85),inset 0 -3px 4px rgba(65,34,5,.4),0 3px 3px rgba(44,24,5,.56);color:#33200a;font:bold 28px\/1 Georgia,serif;text-shadow:0 1px rgba(255,236,164,.75);cursor:pointer}.btn:hover{filter:brightness(1.08)}.btn:active{transform:translateY(2px);box-shadow:inset 0 3px 5px rgba(53,28,5,.55),0 1px 1px rgba(44,24,5,.5)}.btn:focus-visible{outline:2px solid #fff3b5;outline-offset:2px}.reset{font:700 11px\/1 Helvetica,Arial,sans-serif;letter-spacing:.5px;text-transform:uppercase}.btn:disabled{opacity:.48;cursor:default;filter:none}@media(prefers-reduced-motion:no-preference){.display.changed{animation:click .14s ease-out}@keyframes click{50%{filter:brightness(1.55);transform:translateY(-1px)}}}<\/style><\/head><body><main class=\"widget\" aria-label=\"Mechanical counter\"><i class=\"screw tl\"><\/i><i class=\"screw tr\"><\/i><i class=\"screw bl\"><\/i><i class=\"screw br\"><\/i><section class=\"counter\"><output id=\"display\" class=\"display\" aria-live=\"polite\" aria-atomic=\"true\">0000<\/output><\/section><div class=\"controls\"><button class=\"btn\" id=\"minus\" type=\"button\" aria-label=\"Decrease count\">−<\/button><button class=\"btn\" id=\"plus\" type=\"button\" aria-label=\"Increase count\">+<\/button><button class=\"btn reset\" id=\"reset\" type=\"button\">Reset<\/button><\/div><\/main><script>(()=>{const MIN=-999,MAX=9999;let raw=window.dashboardState&&window.dashboardState.count;let count=Number.isInteger(raw)?Math.max(MIN,Math.min(MAX,raw)):0;const display=document.getElementById('display'),minus=document.getElementById('minus'),plus=document.getElementById('plus'),reset=document.getElementById('reset');function format(n){return n<0?'−'+String(Math.abs(n)).padStart(3,'0'):String(n).padStart(4,'0')}function render(animate=false){display.textContent=format(count);display.setAttribute('aria-label','Count '+count);minus.disabled=count<=MIN;plus.disabled=count>=MAX;reset.disabled=count===0;if(animate){display.classList.remove('changed');void display.offsetWidth;display.classList.add('changed')}}function setCount(next){next=Math.max(MIN,Math.min(MAX,next));if(next===count)return;count=next;render(true);if(typeof window.saveDashboardState==='function')window.saveDashboardState({count})}minus.addEventListener('click',()=>setCount(count-1));plus.addEventListener('click',()=>setCount(count+1));reset.addEventListener('click',()=>setCount(0));render()})();<\/script><\/body><\/html>","name":"Brass Mechanical Counter","height":180}